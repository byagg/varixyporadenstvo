{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "varixyporadenstvo-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://varixyporadenstvo.com,https://varixyporadenstvo.pages.dev,https://9f886e99.varixyporadenstvo.pages.dev",
    "RECIPIENT_EMAIL": "varixyporadenstvo@gmail.com",
    "SENDER_EMAIL": "kontakt@varixyporadenstvo.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "varixyporadenstvo@gmail.com"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
