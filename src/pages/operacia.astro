---
import Layout from "../layouts/Layout.astro";
import Page from "../components/pages/operacia/page";

export const prerender = true;
---

<Layout title="Všeobecné zásady pred a po operačnom zákroku | Varixy a Operácia | varixyporadenstvo">
  <Fragment slot="head">
    <meta name="description" content="Zoznámte sa s metódami a výhodami operačného zákroku na varixy. Pozrite si ako prebieha operácia varixov na operačnej sále. Zo zákulisa sledujte čo sa deje na sále." />
    <meta name="keywords" content="operácia, varixy, operačný zákrok" />
    <meta property="og:title" content="Všeobecné zásady pred a po operačnom zákroku | Varixy a Operácia | varixyporadenstvo" />
    <meta property="og:description" content="Zoznámte sa s metódami a výhodami operačného zákroku na varixy. Pozrite si ako prebieha operácia varixov na operačnej sále. Zo zákulisa sledujte čo sa deje na sále." />
    <meta property="og:image" content="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1440,h=756,fit=crop,f=jpeg/ALpBQyXKnqhOakP5/ideogram-49-mnlnD7q19KFW69xb.jpeg" />
    <meta property="og:url" content="https://varixyporadenstvo.com/operacia" />
    <meta property="og:site_name" content="varixyporadenstvo" />
