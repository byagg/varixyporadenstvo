---
import Layout from "../layouts/Layout.astro";
import Page from "../components/pages/home/page";

export const prerender = true;

const title = "Kŕčové žily: príznaky, diagnostika a liečba";
const description =
  "Odborné informácie o kŕčových žilách: príznaky, diagnostika, prevencia, komplikácie a možnosti liečby vrátane sklerotizácie, laseru, RFA a operácie.";
const image =
  "/migrated-assets/f28b9f3d449e773982d1.jpg";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  description,
  inLanguage: "sk",
  about: {
    "@type": "MedicalCondition",
    name: "Kŕčové žily",
    alternateName: "Varixy dolných končatín",
  },
};
---

<Layout
  title={title}
  description={description}
  canonical="/"
  image={image}
  imageAlt="Ilustrácia poradenstva o kŕčových žilách"
  siteName="Varixy Poradenstvo"
  jsonLd={jsonLd}
>
  <Page client:load />
</Layout>
