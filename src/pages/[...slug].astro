---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import type { Article, WithContext } from "schema-dts";

export const prerender = true;

export async function getStaticPaths() {
  const entries = (await getCollection("pages")).filter(
    (entry) => !entry.data.draft,
  );

  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\/index$/, "") },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const articleJsonLd: WithContext<Article> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  name: entry.data.title,
  ...(entry.data.description && { description: entry.data.description }),
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: entry.data.pubDate.toISOString(),
  ...(canonicalUrl && {
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
  }),
};
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  jsonLd={articleJsonLd}
>
  <article class="prose mx-auto max-w-3xl px-4 py-12">
    <Content />
  </article>
</Layout>
