---
import Layout from "../layouts/Layout.astro";
import Page from "../components/pages/kody-pancuch/page";

export const prerender = true;
---

<Layout
  title="Kódy kompresívnych pančúch – zoznam G kódov pre lekárov"
  description="Kompletný zoznam kategorizovaných kompresívnych pančúch s G kódmi, cenou, úhradou zdravotnej poisťovne, doplatkom pacienta a preskripčnými obmedzeniami."
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="G kódy, kompresívne pančuchy, kategorizácia, preskripcia, doplatok"
    />
  </Fragment>
  <Page client:load />
</Layout>
