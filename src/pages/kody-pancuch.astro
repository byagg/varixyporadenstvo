---
import Layout from "../layouts/Layout.astro";
import Page from "../components/pages/kody-pancuch/page";

export const prerender = true;
---

<Layout
  title="Kódy kompresívnych pomôcok – zoznam G kódov pre lekárov"
  description="Kategorizované pomôcky na kompresívnu liečbu (kapitola G) – pančuchy, ramenné návleky, rukavice, prístroje a pomôcky na lymfedém s G kódmi, cenou, úhradou, doplatkom a preskripciou."
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="G kódy, kompresívne pančuchy, lymfedém, kompresívna liečba, kategorizácia, preskripcia, doplatok"
    />
  </Fragment>
  <Page client:load />
</Layout>
