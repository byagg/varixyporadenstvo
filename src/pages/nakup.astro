---
import Layout from "../layouts/Layout.astro";
import Page from "../components/pages/nakup/page";

export const prerender = true;
---

<Layout title="Lieky a prípravky pre predoperačné a pooperačné obdobie, pohodlný nákup | varixyporadenstvo">
  <Fragment slot="head">
    <meta name="description" content="Pozrite si výber liekov a prípravkov použiteľných v predoperačnom a pooperačnom období pre operáciu varixov s výhodnými cenami z e-shopov. Názvy, lieky, nákup, linky k predajcom a viac." />
    <meta name="keywords" content="lieky, prípravky, nákup" />
    <meta property="og:title" content="Lieky a prípravky pre predoperačné a pooperačné obdobie, pohodlný nákup | varixyporadenstvo" />
    <meta property="og:description" content="Pozrite si výber liekov a prípravkov použiteľných v predoperačnom a pooperačnom období pre operáciu varixov s výhodnými cenami z e-shopov. Názvy, lieky, nákup, linky k predajcom a viac." />
    <meta property="og:image" content="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1440,h=756,fit=crop,f=jpeg/ALpBQyXKnqhOakP5/ideogram-49-mnlnD7q19KFW69xb.jpeg" />
    <meta property="og:url" content="https://varixyporadenstvo.com/nakup" />
    <meta property="og:site_name" content="varixyporadenstvo" />
  </Fragment>
  <Page client:load />
</Layout>
