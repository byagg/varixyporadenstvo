---
import Layout from "../layouts/Layout.astro";
import Page from "../components/pages/kliniky/page";

export const prerender = true;
---

<Layout
  title="Kliniky na Slovensku. Zobrazenie názvov kliník s fokusom na varixy dolných končatín."
  description="Zobrazte si kompletný zoznam kliník, kde sa vykonávajú zákroky na kŕčové žily dolných končatín a vyberte tú správnu pre vás. Kliniky s prehľadný zoznamom a s pravidelnou aktualizáciou."
  image="/migrated-assets/f28b9f3d449e773982d1.jpg"
>
  <Fragment slot="head">
    <meta name="keywords" content="zobrazenie, dolných končatín, kliniky" />
  </Fragment>
  <Page client:load />
</Layout>
