---
import Layout from "../layouts/Layout.astro";
import Page from "../components/pages/kliniky/page";

export const prerender = true;
---

<Layout title="Kliniky na Slovensku. Zobrazenie názvov kliník s fokusom na varixy dolných končatín. | varixyporadenstvo">
  <Fragment slot="head">
    <meta name="description" content="Zobrazte si kompletný zoznam kliník, kde sa vykonávajú zákroky na kŕčové žily dolných končatín a vyberte tú správnu pre vás. Kliniky s prehľadný zoznamom a s pravidelnou aktualizáciou." />
    <meta name="keywords" content="zobrazenie, dolných končatín, kliniky" />
    <meta property="og:title" content="Kliniky na Slovensku. Zobrazenie názvov kliník s fokusom na varixy dolných končatín. | varixyporadenstvo" />
    <meta property="og:description" content="Zobrazte si kompletný zoznam kliník, kde sa vykonávajú zákroky na kŕčové žily dolných končatín a vyberte tú správnu pre vás. Kliniky s prehľadný zoznamom a s pravidelnou aktualizáciou." />
    <meta property="og:image" content="/migrated-assets/f28b9f3d449e773982d1.jpg" />
    <meta property="og:url" content="https://varixyporadenstvo.com/kliniky" />
